rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() < 128;
    }

    match /audits/{auditId} {
      allow read: if true;
      allow create, update: if isValidId(auditId)
        && request.resource.data.projectName is string
        && request.resource.data.complianceScore is number
        && request.resource.data.complianceScore >= 0
        && request.resource.data.complianceScore <= 100
        && request.resource.data.status is string;
      allow delete: if isValidId(auditId);
    }
  }
}
